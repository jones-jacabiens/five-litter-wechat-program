<view class="tabbar-wrap">
  <view class="tabbar-ink">
    <view class="tabbar-item {{selected === index ? 'active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab">
      <image class="tabbar-icon" src="{{selected === index ? item.activeIcon : item.icon}}"></image>
      <text class="tabbar-text">{{item.text}}</text>
    </view>
  </view>
</view>
