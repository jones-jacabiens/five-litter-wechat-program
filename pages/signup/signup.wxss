.signup-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF8F2 0%, #F3EBDE 100%);
}
.hero-section {
  background: linear-gradient(135deg, var(--red-deep), var(--red));
  padding: 60rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero-section::after {
  content: '';
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 220rpx;
  height: 220rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}
.hero-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  font-family: var(--font-title);
  letter-spacing: 4rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
  display: block;
}
.price-tag {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.price {
  font-size: 72rpx;
  font-weight: bold;
  color: #F2C14E;
}
.price-note {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}
.form-section {
  background: #F7F3EC;
  border: 2rpx solid rgba(201, 162, 39, 0.5);
  margin: 30rpx 20rpx;
  border-radius: 24rpx 28rpx 24rpx 28rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 26, 43, 0.06);
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  height: 80rpx;
  border: 2rpx solid var(--gold-light);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  background: #FBF8F2;
  color: var(--ink);
}
.form-picker {
  height: 80rpx;
  border: 2rpx solid var(--gold-light);
  border-radius: 14rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #FBF8F2;
}
.picker-display {
  color: var(--ink);
}
.submit-btn {
  margin: 20rpx 40rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(192, 57, 43, 0.35);
}
.submit-btn::after {
  content: ' ››';
  font-size: 40rpx;
}
.footer-info {
  text-align: center;
  padding: 20rpx;
}

/* 延伸产品 */
.st-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #B0272E;
  font-family: var(--font-title);
  margin: 10rpx 24rpx 18rpx;
}
.st-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D63031;
  margin-right: 12rpx;
}
.ext-section { padding: 20rpx 0 10rpx; }
.ext-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 24rpx; }
.ext-card {
  width: calc(50% - 10rpx);
  background: #F7F3EC;
  border: 2rpx solid rgba(51, 51, 51, 0.15);
  border-radius: 18rpx 24rpx 18rpx 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.ext-name { font-size: 28rpx; font-weight: bold; color: #3A3A3A; }
.ext-desc { font-size: 20rpx; color: #8A8478; margin-top: 6rpx; display: block; line-height: 1.5; }
.ext-status {
  display: inline-block;
  font-size: 18rpx;
  color: #fff;
  background: #C9A227;
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
  margin-top: 10rpx;
}

/* 快捷入口 */
.quick-section { padding: 10rpx 24rpx 30rpx; }
.quick-grid { display: flex; flex-wrap: wrap; }
.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.quick-icon { width: 64rpx; height: 64rpx; }
.quick-name { font-size: 22rpx; color: #3A3A3A; margin-top: 10rpx; }
.footer-text {
  font-size: 24rpx;
  color: var(--ink-light);
}

.spots-info{font-size:22rpx;color:var(--red);margin-top:6rpx;display:block}
