<view class="profile-container">
  <!-- 用户卡 -->
  <view class="user-card">
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-img" src="{{userInfo.avatarUrl || ''}}" wx:if="{{userInfo.avatarUrl}}"></image>
        <image class="avatar-emoji" wx:else src="/image/icon-user.png"></image>
      </button>
      <view class="user-info">
        <input class="user-name-input" type="nickname" placeholder="输入昵称" bindinput="onNickNameInput" value="{{userInfo.nickName}}" />
        <text class="user-role">{{userInfo.school + ' · ' + userInfo.grade}}</text>
      </view>
      <view class="edit-btn" bindtap="onEditProfile"><text class="edit-btn-text">编辑</text></view>
    </view>
    <view class="user-stats">
      <view class="stat-item"><text class="stat-num">{{stats.visitedSites || 0}}</text><text class="stat-label">已探索站点</text></view>
      <view class="stat-item"><text class="stat-num">{{stats.trips || 0}}</text><text class="stat-label">研学次数</text></view>
      <view class="stat-item"><text class="stat-num">{{stats.totalScore || 0}}</text><text class="stat-label">总积分</text></view>
      <view class="stat-item"><text class="stat-num">{{unlockedCount || 0}}</text><text class="stat-label">获得勋章</text></view>
    </view>
  </view>

  <!-- 五小 IP 身份 -->
  <view class="ip-card">
    <image class="ip-img" src="/image/非遗小工匠.jpg" mode="aspectFill"></image>
    <view class="ip-main">
      <text class="ip-title">非遗小工匠 · 剪纸小能手</text>
      <text class="ip-level">传承大师 · 五阶</text>
      <text class="ip-desc">耐心专注 · 空间认知 · 文化感知</text>
    </view>
  </view>

  <!-- 活动中心 -->
  <view class="center-section">
    <view class="section-header"><view class="section-title">活动中心</view></view>
    <view class="center-grid">
      <view class="center-item" wx:for="{{activityCenter}}" wx:key="name" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="centerItemTap">
        <image class="center-icon" src="{{item.icon}}"></image>
        <text class="center-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
