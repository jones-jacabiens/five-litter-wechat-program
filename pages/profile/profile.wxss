.profile-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF8F2 0%, #F3EBDE 100%);
  padding: 30rpx;
  padding-bottom: 140rpx;
}

/* ===== 用户卡 ===== */
.user-card {
  background: linear-gradient(120deg, #F7F3EC, #F1E7D9);
  border: 2rpx solid rgba(201, 162, 39, 0.5);
  border-radius: 26rpx 20rpx 26rpx 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 26, 43, 0.07);
  margin-bottom: 24rpx;
}
.avatar-section { display: flex; align-items: center; margin-bottom: 30rpx; }
.avatar-btn {
  width: 100rpx; height: 100rpx; border-radius: 50%; padding: 0; margin: 0; margin-right: 24rpx;
  background: linear-gradient(135deg, #D63031, #B0272E); display: flex; align-items: center; justify-content: center;
  border: none; overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.avatar-emoji { width: 56rpx; height: 56rpx; }
.user-info { flex: 1; }
.user-name-input { font-size: 32rpx; font-weight: bold; color: #3A3A3A; height: 48rpx; border: none; background: transparent; }
.user-role { font-size: 24rpx; color: #6B6560; margin-top: 8rpx; }
.edit-btn { background: rgba(201, 162, 39, 0.18); padding: 8rpx 24rpx; border-radius: 30rpx; }
.edit-btn-text { font-size: 24rpx; color: #B0272E; }
.user-stats { display: flex; justify-content: space-around; border-top: 2rpx solid rgba(201, 162, 39, 0.4); padding-top: 30rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #D63031; }
.stat-label { font-size: 22rpx; color: #6B6560; margin-top: 8rpx; }

/* ===== 五小 IP 身份 ===== */
.ip-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #B0272E, #D63031);
  border-radius: 24rpx 18rpx 24rpx 18rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(176, 39, 46, 0.3);
}
.ip-img { width: 120rpx; height: 120rpx; border-radius: 20rpx; border: 2rpx solid rgba(255, 255, 255, 0.5); flex-shrink: 0; }
.ip-main { margin-left: 24rpx; }
.ip-title { display: block; font-size: 30rpx; font-weight: bold; color: #fff; font-family: var(--font-title); }
.ip-level { display: inline-block; font-size: 20rpx; color: #F2C14E; background: rgba(255, 255, 255, 0.15); border-radius: 16rpx; padding: 2rpx 14rpx; margin-top: 10rpx; }
.ip-desc { display: block; font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 10rpx; }

/* ===== 活动中心 ===== */
.center-section {
  background: linear-gradient(120deg, #F7F3EC, #F1E7D9);
  border: 2rpx solid rgba(201, 162, 39, 0.5);
  border-radius: 22rpx 18rpx 22rpx 18rpx;
  padding: 26rpx 16rpx;
  margin-bottom: 24rpx;
}
.section-header { padding: 0 10rpx 18rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #B0272E; font-family: var(--font-title); }
.center-grid { display: flex; flex-wrap: wrap; }
.center-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 18rpx 0; }
.center-icon { width: 64rpx; height: 64rpx; }
.center-name { font-size: 22rpx; color: #3A3A3A; margin-top: 12rpx; }

/* ===== 登录 ===== */
.login-section { padding: 0 20rpx; margin-bottom: 20rpx; }
.login-card {
  background: #F7F3EC; border: 2rpx solid rgba(201, 162, 39, 0.5);
  border-radius: 20rpx 24rpx 20rpx 24rpx; padding: 24rpx;
}
.login-title { font-size: 28rpx; font-weight: bold; color: #3A3A3A; display: block; margin-bottom: 16rpx; text-align: center; font-family: var(--font-title); }
.login-btn { width: 100%; height: 64rpx; line-height: 64rpx; background: linear-gradient(135deg, #D63031, #B0272E); color: #fff; font-size: 26rpx; border-radius: 32rpx; margin-bottom: 10rpx; }
.login-btn.phone { background: #FBF8F2; color: #D63031; border: 2rpx solid #D63031; }
.login-hint { font-size: 22rpx; color: #6B6560; text-align: center; display: block; margin-top: 10rpx; }
.login-card.logged { padding: 20rpx; text-align: center; }
.login-status { font-size: 26rpx; color: #3A3A3A; display: block; }
.login-status.small { font-size: 22rpx; color: #6B6560; margin-top: 6rpx; }

/* ===== 功能列表 ===== */
.settings-list {
  background: linear-gradient(120deg, #F7F3EC, #F1E7D9);
  border: 2rpx solid rgba(201, 162, 39, 0.5);
  border-radius: 22rpx 18rpx 22rpx 18rpx;
  overflow: hidden;
}
.setting-item { display: flex; align-items: center; padding: 30rpx; border-bottom: 2rpx solid rgba(201, 162, 39, 0.3); }
.setting-item:last-child { border-bottom: none; }
.setting-icon { width: 40rpx; height: 40rpx; margin-right: 20rpx; }
.setting-label { flex: 1; font-size: 28rpx; color: #3A3A3A; }
.setting-arrow { font-size: 32rpx; color: #6B6560; }
