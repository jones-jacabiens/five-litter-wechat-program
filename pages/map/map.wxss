.page-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #F3EBDE;
}

/* ==================== 微信原生地图（全屏，原生捏合缩放） ==================== */
.map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 地形 / 卫星切换 */
.layer-toggle {
  position: absolute;
  left: 20rpx;
  top: 120rpx;
  z-index: 30;
  background: #FBF8F2;
  border: 2rpx solid rgba(51, 51, 51, 0.35);
  border-radius: 30rpx;
  padding: 10rpx 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 40, 0.14);
}
.layer-toggle-text {
  font-size: 24rpx;
  color: #3A3A3A;
  font-family: var(--font-title);
}

/* ==================== 顶部标题 ==================== */
.map-header {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}
.map-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #B0272E, #D63031);
  padding: 10rpx 32rpx;
  border-radius: 34rpx 34rpx 34rpx 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(139, 26, 43, 0.22);
  font-family: var(--font-title);
}

/* ==================== 底部操作提示 ==================== */
.map-tip {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 10;
  pointer-events: none;
}
.tip-text {
  font-size: 22rpx;
  color: #3A3A3A;
  background: #FBF8F2;
  border: 2rpx solid rgba(51, 51, 51, 0.35);
  padding: 6rpx 24rpx;
  border-radius: 26rpx;
}

/* ==================== 实时定位浮层 ==================== */
.gps-overlay {
  position: absolute;
  bottom: 100rpx;
  right: 20rpx;
  background: #FBF8F2;
  border: 2rpx solid rgba(51, 51, 51, 0.3);
  border-radius: 18rpx 26rpx 18rpx 26rpx;
  padding: 20rpx;
  min-width: 280rpx;
  box-shadow: 0 4rpx 14rpx rgba(60, 50, 40, 0.1);
  z-index: 20;
}
.gps-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.gps-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  font-family: var(--font-title);
}
.gps-title-icon { width: 30rpx; height: 30rpx; margin-right: 8rpx; }
.gps-switch-wrap {
  border: 2rpx solid rgba(51, 51, 51, 0.45);
  border-radius: 30rpx;
  padding: 2rpx 4rpx;
}
.gps-switch { transform: scale(0.8); }
.gps-list {
  margin-top: 12rpx;
  border-top: 2rpx solid rgba(51, 51, 51, 0.12);
  padding-top: 12rpx;
}
.gps-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 24rpx;
}
.gps-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.dot-active {
  background: #D63031;
  animation: gpsRipple 1.5s ease-in-out infinite;
  box-shadow: 0 0 10rpx rgba(214, 48, 49, 0.6);
}

@keyframes gpsRipple {
  0% { transform: scale(0.8); opacity: 0.7; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.7; }
}
.gps-name { font-weight: 500; color: #3A3A3A; min-width: 140rpx; }
.gps-loc { color: #6B6560; font-size: 22rpx; }

/* ==================== 路线滑动卡片 ==================== */
.route-panel{position:absolute;bottom:120rpx;left:0;right:0;z-index:15;padding:0 20rpx}
.route-panel.collapsed{bottom:140rpx}
.route-toggle{
  background: #FBF8F2;
  border: 2rpx solid rgba(51, 51, 51, 0.4);
  padding: 6rpx 26rpx;
  border-radius: 30rpx;
  display: inline-block;
  margin: 0 auto 12rpx;
}
.route-toggle-text{font-size:24rpx;color:#3A3A3A;text-align:center;display:block;font-family:var(--font-title)}
.route-scroll{white-space:nowrap;overflow:hidden}
.route-card{
  display:inline-block;
  width:260rpx;
  height:300rpx;
  border-radius:18rpx 22rpx 18rpx 22rpx;
  overflow:hidden;
  margin-right:16rpx;
  background:#FBF8F2;
  border:2rpx solid rgba(51, 51, 51, 0.3);
  box-shadow:0 4rpx 14rpx rgba(60, 50, 40, 0.08);
  position:relative;
}
.route-card-img{width:100%;height:180rpx}
.route-card-info{padding:12rpx}
.route-card-name{font-size:26rpx;font-weight:bold;color:#B0272E;display:block;font-family:var(--font-title)}
.route-card-desc{font-size:20rpx;color:#6B6560;margin-top:4rpx;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
