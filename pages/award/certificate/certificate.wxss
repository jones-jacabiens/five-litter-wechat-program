.certificate-page{min-height:100vh;background:#f0ebe3;padding:30rpx}
.back-btn{position:fixed;top:20rpx;left:20rpx;z-index:100;font-size:36rpx;color:#333;background:transparent;padding:10rpx;border-radius:0;box-shadow:none}
.certificate-frame{background:#fff;padding:20rpx;border-radius:16rpx;box-shadow:0 4rpx 30rpx rgba(0,0,0,0.1)}
.certificate-border{border:8rpx solid #d4233a;border-image:linear-gradient(135deg,#d4233a,#ffd700,#d4233a) 1;padding:50rpx 30rpx;text-align:center;background:#fffdf5}
.cert-header{margin-bottom:40rpx}
.cert-title{font-size:52rpx;font-weight:bold;color:#d4233a;display:block;letter-spacing:12rpx}
.cert-sub{font-size:20rpx;color:#999;letter-spacing:4rpx;margin-top:10rpx;display:block}
.cert-body{padding:30rpx 0}
.cert-line{font-size:30rpx;color:#555;display:block;line-height:1.8}
.cert-name{font-size:48rpx;font-weight:bold;color:#333;display:block;padding:20rpx 0;letter-spacing:8rpx}
.cert-award{font-size:40rpx;font-weight:bold;color:#d4233a;display:block;padding:30rpx 0}
.cert-footer{margin-top:50rpx;border-top:2rpx solid #eee;padding-top:30rpx}
.cert-date{font-size:24rpx;color:#888;display:block}
.cert-org{font-size:26rpx;color:#666;margin-top:10rpx;display:block}
.form-section{background:#fff;margin-top:30rpx;padding:30rpx;border-radius:16rpx}
.form-item{margin-bottom:24rpx}
.form-label{font-size:26rpx;color:#555;display:block;margin-bottom:10rpx}
.form-input{height:72rpx;border:2rpx solid #ddd;border-radius:10rpx;padding:0 20rpx;font-size:28rpx;width:100%;box-sizing:border-box}
.generate-btn{width:100%;height:80rpx;line-height:80rpx;background:linear-gradient(135deg,#d4233a,#8b1a2b);color:#fff;font-size:32rpx;border-radius:40rpx;margin-top:20rpx}
.download-btn{width:100%;height:80rpx;line-height:80rpx;background:#fff;color:#d4233a;font-size:32rpx;border-radius:40rpx;margin-top:16rpx;border:2rpx solid #d4233a}
