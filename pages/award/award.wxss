.award-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF8F2 0%, #F3EBDE 100%);
  padding-bottom: 40rpx;
}

/* 通用图标尺寸（约为字体2倍，粗线条） */
.icon-xs { width: 48rpx; height: 48rpx; vertical-align: middle; display: inline-block; }
.icon-sm { width: 56rpx; height: 56rpx; vertical-align: middle; display: inline-block; }

/* ===== 荣誉领奖台 ===== */
.podium-section {
  margin: 10rpx 24rpx 10rpx;
  background: linear-gradient(160deg, #F7F3EC, #F1E7D9);
  border: 2rpx solid rgba(51, 51, 51, 0.1);
  border-radius: 24rpx 18rpx 24rpx 18rpx;
  padding: 24rpx 20rpx 20rpx;
}
.podium-title {
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #B0272E;
  font-family: var(--font-title);
  margin-bottom: 16rpx;
}
.podium { display: flex; align-items: flex-end; justify-content: center; gap: 14rpx; }
.podium-step { flex: 1; display: flex; flex-direction: column; align-items: center; }
.podium-figure { width: 64rpx; height: 90rpx; }
.podium-figure.champ { width: 80rpx; height: 112rpx; }
.podium-name { font-size: 22rpx; color: #3A3A3A; font-weight: bold; margin-top: 6rpx; }
.podium-value { font-size: 20rpx; color: #8A8478; }
.podium-block {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 12rpx 12rpx 0 0;
  margin-top: 8rpx;
}
.podium-block.gold { height: 120rpx; background: linear-gradient(180deg, #F2C14E, #C98A2D); }
.podium-block.silver { height: 88rpx; background: linear-gradient(180deg, #E8E8E8, #B9B2A6); }
.podium-block.bronze { height: 66rpx; background: linear-gradient(180deg, #E3B587, #C07A4A); }

/* ===== 双星榜子Tab（国风分段控件） ===== */
.star-tabs {
  display: flex;
  margin: 20rpx 24rpx;
  background: rgba(201, 162, 39, 0.16);
  border: 2rpx solid var(--gold-light);
  border-radius: 18rpx;
  padding: 6rpx;
}
.star-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ink-light);
  border-radius: 12rpx;
}
.star-tab.active {
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: #fff;
  font-weight: bold;
  box-shadow: 0 2rpx 10rpx rgba(192, 57, 43, 0.3);
}

/* ===== 榜单 ===== */
.star-list { padding: 0 24rpx 20rpx; }
.star-header { text-align: center; padding: 24rpx 0 20rpx; }
.star-title {
  display: inline-flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--red-deep);
  font-family: var(--font-title);
}
.star-title .icon-sm { margin-right: 10rpx; }
.star-desc { font-size: 22rpx; color: var(--ink-light); margin-top: 8rpx; display: block; }
.star-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F7F3EC;
  border: 2rpx solid rgba(201, 162, 39, 0.45);
  border-radius: 16rpx 22rpx 16rpx 22rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(139, 26, 43, 0.05);
}
.star-item:nth-child(odd) { border-left: 8rpx solid var(--gold); }
.star-item:nth-child(even) { border-left: 8rpx solid var(--red); border-radius: 22rpx 16rpx 22rpx 16rpx; }
.star-rank { width: 60rpx; font-size: 26rpx; color: var(--ink-light); text-align: center; }
.star-rank.top { color: var(--gold); font-weight: bold; }
.star-name { flex: 1; font-size: 26rpx; color: var(--ink); }
.star-amount { font-size: 28rpx; font-weight: bold; color: var(--red); margin-right: 20rpx; }
.star-school { font-size: 20rpx; color: var(--ink-light); }

/* ===== 电子证书按钮 ===== */
.cert-btn-section { padding: 30rpx 24rpx; }
.cert-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: #fff;
  font-size: 32rpx;
  border-radius: 42rpx;
  box-shadow: 0 6rpx 20rpx rgba(192, 57, 43, 0.3);
}
