.redeem-page{min-height:100vh;background:#f8f8f8;padding:30rpx}
.back-btn{position:fixed;top:20rpx;left:20rpx;z-index:100;font-size:36rpx;color:#333;background:transparent;padding:10rpx;border-radius:0;box-shadow:none}
.redeem-card{background:#fff;border-radius:20rpx;padding:40rpx;margin-top:80rpx;text-align:center;box-shadow:0 4rpx 20rpx rgba(0,0,0,0.06)}
.redeem-icon{font-size:100rpx;display:block}
.redeem-title{font-size:36rpx;font-weight:bold;color:#333;margin-top:20rpx;display:block}
.redeem-cost{font-size:48rpx;font-weight:bold;color:#d4233a;margin-top:16rpx;display:block}
.redeem-balance{font-size:26rpx;color:#888;margin-top:10rpx;display:block}
.redeem-confirm-btn{width:100%;height:88rpx;line-height:88rpx;background:linear-gradient(135deg,#d4233a,#8b1a2b);color:#fff;font-size:34rpx;border-radius:44rpx;margin-top:40rpx}
.redeem-cancel-btn{width:100%;height:72rpx;line-height:72rpx;background:#fff;color:#888;font-size:28rpx;border-radius:36rpx;margin-top:16rpx;border:2rpx solid #ddd}
.rules-section{background:#fff;border-radius:20rpx;padding:30rpx;margin-top:30rpx}
.rules-title{font-size:28rpx;font-weight:bold;color:#333;display:block;margin-bottom:16rpx}
.rules-text{font-size:24rpx;color:#666;line-height:2;display:block}