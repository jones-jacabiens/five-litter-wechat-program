.back-btn {
  position: fixed; top: 20rpx; left: 20rpx; z-index: 100;
  font-size: 28rpx; color: #8b4513; background: rgba(255,255,255,0.9);
  padding: 10rpx 24rpx; border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.book-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #f0e6d3;
  padding: 40rpx;
}

.book {
  width: 600rpx;
  height: 800rpx;
  position: relative;
  display: flex;
  box-shadow: 4rpx 4rpx 20rpx rgba(0,0,0,0.15);
  border-radius: 8rpx;
  overflow: hidden;
}

.page-left, .page-right {
  width: 50%;
  height: 100%;
  position: relative;
  background: #fffaf0;
}

.page-left {
  transform-origin: right center;
  transition: transform 0.6s ease;
  z-index: 2;
}

.page-left.flipped {
  transform: rotateY(-180deg);
}

.page-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.page-front, .page-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.page-back {
  transform: rotateY(180deg);
  background: #fff5e6;
}

.page-number {
  position: absolute;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #999;
}

.page-left .page-number {
  right: 20rpx;
}

.page-right .page-number {
  left: 20rpx;
}

.page-content {
  font-size: 36rpx;
  color: #8b4513;
  text-align: center;
}

.flip-hint {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.page-indicator {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #bbb;
}