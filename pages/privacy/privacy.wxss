.privacy-page{min-height:100vh;background:#fff;padding:30rpx;padding-top:80rpx}
.back-btn{position:fixed;top:20rpx;left:20rpx;z-index:100;font-size:28rpx;color:#333;background:rgba(255,255,255,0.9);padding:10rpx 24rpx;border-radius:30rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.1)}
.privacy-header{font-size:36rpx;font-weight:bold;color:#333;text-align:center;padding:20rpx 0}
.privacy-update{font-size:22rpx;color:#999;text-align:center;margin-bottom:30rpx}
.privacy-content{height:calc(100vh - 260rpx);padding:0 10rpx}
.section-title{font-size:30rpx;font-weight:bold;color:#d4233a;display:block;margin-top:30rpx;margin-bottom:12rpx}
.section-text{font-size:26rpx;color:#555;line-height:1.8;display:block;margin-bottom:8rpx}
.agree-btn{position:fixed;bottom:40rpx;left:30rpx;right:30rpx;height:88rpx;line-height:88rpx;background:linear-gradient(135deg,#d4233a,#8b1a2b);color:#fff;font-size:32rpx;border-radius:44rpx}

.section-bold{font-size:26rpx;color:#555;line-height:1.8;display:block;margin-bottom:8rpx;font-weight:bold}